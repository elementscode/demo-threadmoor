import "./style.css";

<Avatar (src: string | null, name: string, size: string = "md")>
  <span class={["avatar", size !== "md" && `is-${size}`]} title={name}>
    <img e:if={src} src={src ?? undefined} alt="" width="96" height="96" loading="lazy">
    <span e:else aria-hidden="true">{name.slice(0, 1)}</span>
  </span>
</Avatar>
