import "./style.css";
import { redirect } from "@elements/app";
import { Badge } from "@elements/ui/badge";
import { Chrome } from "#app/shared/services/forum";
import { signin } from "#app/shared/services/auth";
import { Layout } from "#app/shared/templates/layout";
import { Avatar } from "@elements/ui/avatar";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import favicon from "#app/shared/assets/favicons/favicon.svg";

export const DEMO_PASSWORD = "sawdust123";

export interface DemoLogin {
  id: string;
  handle: string;
  email: string;
  displayName: string;
  avatar: string | null;
  isModerator: boolean;
}

interface SigninForm {
  login: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SigninForm, next: string) {
  form.busy = true;

  try {
    signin(form.login, form.password);
    form.error = "";
    redirect(next);
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function onDemoClick(form: SigninForm, demo: DemoLogin, next: string) {
  form.login = demo.email;
  form.password = DEMO_PASSWORD;
  onSubmit(form, next);
}

<html lang="en" class="page-signin" (
  chrome: Chrome,
  demos: DemoLogin[],
  next: string,
  private form: SigninForm = { login: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · threadmoor</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout chrome={chrome}>
      <div class="page-shell">
        <div class={["auth", demos.length === 0 && "is-single"]}>
          <Card size="sm">
            <CardContent>
              <form class="stack is-md" onsubmit={() => onSubmit(form, next)}>
                <div class="stack is-xs">
                  <h1>Sign in</h1>
                  <p class="auth-alt">Welcome back to the shop.</p>
                </div>

                <Alert e:if={form.error} variant="danger" description={form.error} />

                <Field label="Email or handle" reserveError={false}>
                  <Input name="login"
                         value={form.login}
                         placeholder="you@example.com"
                         required
                         attrs={{ id: "login", autocomplete: "username", autocapitalize: "none", spellcheck: "false" }} />
                </Field>

                <Field label="Password" reserveError={false}>
                  <Input name="password"
                         type="password"
                         value={form.password}
                         required
                         attrs={{ id: "password", autocomplete: "current-password" }} />
                </Field>

                <Button type="submit" variant="primary" block loading={form.busy}>Sign in</Button>

                <p class="auth-alt">New here? <a href="/signup">Create an account</a></p>
              </form>
            </CardContent>
          </Card>

          <Card e:if={demos.length > 0} title="Demo logins" level={2} size="sm">
            <CardContent class="stack is-sm">
              <p class="auth-alt">
                Every seeded account uses the password <code class="demo-password">{DEMO_PASSWORD}</code>. Click one to sign in.
              </p>
              <ul class="demo-logins">
                <li e:for={d of demos}>
                  <button type="button" class="demo-login" onclick={() => onDemoClick(form, d, next)}>
                    <Avatar src={d.avatar ?? ""} alt={d.handle} size="sm" />
                    <span class="demo-login-name">
                      <strong>{d.displayName}</strong>
                      <span>{d.email}</span>
                    </span>
                    <Badge e:if={d.isModerator} variant="accent">Moderator</Badge>
                  </button>
                </li>
              </ul>
            </CardContent>
          </Card>
        </div>
      </div>
    </Layout>
  </body>
</html>
