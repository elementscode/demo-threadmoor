import "./style.css";
import { redirect, ValidationError } from "@elements/app";
import { Chrome } from "#app/shared/services/forum";
import { signup, MIN_PASSWORD, SignupForm } from "#app/shared/services/auth";
import { Layout } from "#app/shared/templates/layout";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface SignupState {
  form: SignupForm;
  errors: Record<string, string[]>;
  error: string;
  busy: boolean;
}

function onSubmit(state: SignupState) {
  state.busy = true;

  try {
    signup(state.form);
    state.errors = {};
    state.error = "";
    redirect("/settings?welcome=1");
  } catch (err: any) {
    if (err instanceof ValidationError && typeof err.errors === "object") {
      state.errors = err.errors as Record<string, string[]>;
      state.error = "";
    } else {
      state.errors = {};
      state.error = err.message;
    }

    state.busy = false;
  }
}

<html lang="en" class="page-signup" (
  chrome: Chrome,
  private state: SignupState = {
    form: { handle: "", email: "", password: "" },
    errors: {},
    error: "",
    busy: false,
  },
)>
  <head>
    <title>Join · threadmoor</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout chrome={chrome}>
      <div class="page-shell">
        <div class="auth is-single">
          <Card size="sm">
            <CardContent>
              <form class="stack is-md" onsubmit={() => onSubmit(state)}>
                <div class="stack is-xs">
                  <h1>Join threadmoor</h1>
                  <p class="auth-alt">Post your projects, ask questions, follow the topics you care about.</p>
                </div>

                <Alert e:if={state.error} variant="danger" description={state.error} />

                <Field label="Handle"
                       description="How you appear on posts. Letters, numbers, dots and dashes."
                       error={state.errors.handle?.[0] ?? ""}>
                  <Input name="handle"
                         type="text"
                         value={state.form.handle}
                         placeholder="benchdog"
                         required
                         attrs={{ id: "handle", autocomplete: "username", autocapitalize: "none", spellcheck: "false" }} />
                </Field>

                <Field label="Email"
                       description="For your daily digest of followed topics. Never shown."
                       error={state.errors.email?.[0] ?? ""}>
                  <Input name="email"
                         type="email"
                         value={state.form.email}
                         placeholder="you@example.com"
                         required
                         attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
                </Field>

                <Field label="Password"
                       description={`At least ${MIN_PASSWORD} characters.`}
                       error={state.errors.password?.[0] ?? ""}>
                  <Input name="password"
                         type="password"
                         value={state.form.password}
                         required
                         attrs={{ id: "password", autocomplete: "new-password", minlength: MIN_PASSWORD }} />
                </Field>

                <Button type="submit" variant="primary" block loading={state.busy}>Create account</Button>

                <p class="auth-alt">Already a member? <a href="/signin">Sign in</a></p>
              </form>
            </CardContent>
          </Card>
        </div>
      </div>
    </Layout>
  </body>
</html>
